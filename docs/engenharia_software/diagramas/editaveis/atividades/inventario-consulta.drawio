<mxfile host="app.diagrams.net"><diagram id="inventario-consulta" name="Inventário Arbóreo — Consulta e ficha técnica"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="2180"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Inventário Arbóreo — Consulta e ficha técnica" style="text;align=left;fontSize=26;fontStyle=1;fontColor=#173D32;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="20" width="1320" height="50" /></mxCell><mxCell id="lane0" value="Funcionário AMMA" style="swimlane;startSize=50;horizontal=1;fillColor=#E7F0EB;swimlaneFillColor=#FFFFFF;strokeColor=#A6B8B0;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="90" width="440" height="2045" /></mxCell><mxCell id="lane1" value="Sistema" style="swimlane;startSize=50;horizontal=1;fillColor=#E7F0EB;swimlaneFillColor=#FFFFFF;strokeColor=#A6B8B0;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="480" y="90" width="880" height="2045" /></mxCell><mxCell id="inicio" value="" style="ellipse;fillColor=#263D34;strokeColor=#263D34;" vertex="1" parent="1"><mxGeometry as="geometry" x="249.0" y="165" width="22" height="22" /></mxCell><mxCell id="abre" value="Acessa o Inventário Arbóreo" style="rounded=1;arcSize=20;whiteSpace=wrap;html=0;fillColor=#FFFBEA;strokeColor=#62796F;strokeWidth=1.5;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="110.0" y="230" width="300" height="80" /></mxCell><mxCell id="criterios" value="Usa os critérios iniciais ou informa pesquisa e filtros" style="rounded=1;arcSize=20;whiteSpace=wrap;html=0;fillColor=#FFFBEA;strokeColor=#62796F;strokeWidth=1.5;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="110.0" y="365" width="300" height="100" /></mxCell><mxCell id="consulta" value="Consulta tabela e mapa com os mesmos critérios; pagina somente a tabela" style="rounded=1;arcSize=20;whiteSpace=wrap;html=0;fillColor=#FFFBEA;strokeColor=#62796F;strokeWidth=1.5;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="745.0" y="565" width="350" height="100" /></mxCell><mxCell id="ok" value="Consulta concluída?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#FFFBEA;strokeColor=#62796F;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="975.0" y="725" width="190" height="110" /></mxCell><mxCell id="falha" value="Exibe falha ou acesso indisponível; não apresenta erro como inventário vazio" style="rounded=1;arcSize=20;whiteSpace=wrap;html=0;fillColor=#FFFBEA;strokeColor=#62796F;strokeWidth=1.5;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="530.0" y="900" width="320" height="100" /></mxCell><mxCell id="fimErro" value="" style="shape=doubleEllipse;fillColor=#263D34;strokeColor=#263D34;" vertex="1" parent="1"><mxGeometry as="geometry" x="676.0" y="1050" width="28" height="28" /></mxCell><mxCell id="tem" value="Há resultados?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#FFFBEA;strokeColor=#62796F;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="975.0" y="1080" width="190" height="110" /></mxCell><mxCell id="vazio" value="Informa que não há árvores para os critérios aplicados" style="rounded=1;arcSize=20;whiteSpace=wrap;html=0;fillColor=#FFFBEA;strokeColor=#62796F;strokeWidth=1.5;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="530.0" y="1220" width="320" height="90" /></mxCell><mxCell id="fimVazio" value="" style="shape=doubleEllipse;fillColor=#263D34;strokeColor=#263D34;" vertex="1" parent="1"><mxGeometry as="geometry" x="676.0" y="1360" width="28" height="28" /></mxCell><mxCell id="resultados" value="Exibe a listagem paginada e os marcadores do conjunto filtrado" style="rounded=1;arcSize=20;whiteSpace=wrap;html=0;fillColor=#FFFBEA;strokeColor=#62796F;strokeWidth=1.5;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="895.0" y="1420" width="350" height="90" /></mxCell><mxCell id="seleciona" value="Seleciona uma árvore na tabela ou no mapa e abre a ficha" style="rounded=1;arcSize=20;whiteSpace=wrap;html=0;fillColor=#FFFBEA;strokeColor=#62796F;strokeWidth=1.5;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="110.0" y="1550" width="300" height="90" /></mxCell><mxCell id="busca" value="Consulta a ficha técnica da árvore selecionada" style="rounded=1;arcSize=20;whiteSpace=wrap;html=0;fillColor=#FFFBEA;strokeColor=#62796F;strokeWidth=1.5;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="895.0" y="1550" width="350" height="90" /></mxCell><mxCell id="fichaok" value="Ficha disponível?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#FFFBEA;strokeColor=#62796F;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="975.0" y="1690" width="190" height="110" /></mxCell><mxCell id="naoFicha" value="Distingue árvore não encontrada, acesso negado e falha de consulta" style="rounded=1;arcSize=20;whiteSpace=wrap;html=0;fillColor=#FFFBEA;strokeColor=#62796F;strokeWidth=1.5;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="530.0" y="1840" width="320" height="90" /></mxCell><mxCell id="fimFichaErro" value="" style="shape=doubleEllipse;fillColor=#263D34;strokeColor=#263D34;" vertex="1" parent="1"><mxGeometry as="geometry" x="676.0" y="1985" width="28" height="28" /></mxCell><mxCell id="ficha" value="Exibe identificação, localização, dados técnicos e galeria de fotografias" style="rounded=1;arcSize=20;whiteSpace=wrap;html=0;fillColor=#FFFBEA;strokeColor=#62796F;strokeWidth=1.5;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="895.0" y="1870" width="350" height="100" /></mxCell><mxCell id="fim" value="" style="shape=doubleEllipse;fillColor=#263D34;strokeColor=#263D34;" vertex="1" parent="1"><mxGeometry as="geometry" x="1056.0" y="2070" width="28" height="28" /></mxCell><mxCell id="e1" value="" edge="1" parent="1" source="inicio" target="abre" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1