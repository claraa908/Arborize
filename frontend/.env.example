# URL local da API; ajuste se a porta do backend for diferente.
VITE_API_URL=http://localhost:8080

# Chave pública de navegador MapTiler; restrinja os Allowed HTTP origins
# para http://localhost:5173 e http://127.0.0.1:5173. Nunca use chave secreta.
# Copie este arquivo para .env.local (ignorado pelo Git) e consulte o README.
VITE_MAPTILER_API_KEY=your_maptiler_api_key
