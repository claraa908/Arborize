# Copie para .env e preencha os valores antes de iniciar os serviços locais.
# Gere segredos locais com `openssl rand -hex 24`; não reutilize senhas institucionais.
ARBORIZA_DB_NAME=arborize_dev
ARBORIZA_DB_USER=arborize_dev
ARBORIZA_DB_PASSWORD=
ARBORIZA_DB_PORT=55433

ARBORIZA_MINIO_ACCESS_KEY=
ARBORIZA_MINIO_SECRET_KEY=
ARBORIZA_MINIO_API_PORT=19000
ARBORIZA_MINIO_CONSOLE_PORT=19001

ARBORIZA_PGADMIN_EMAIL=admin@localhost.invalid
ARBORIZA_PGADMIN_PASSWORD=
ARBORIZA_PGADMIN_PORT=15050

# Use somente conta fictícia em domínio reservado .invalid.
ARBORIZA_DEV_ADMIN_BOOTSTRAP_ENABLED=false
ARBORIZA_DEV_ADMIN_EMAIL=admin.dev@example.invalid
ARBORIZA_DEV_ADMIN_PASSWORD=

# Opcional: sem valor, o backend local gera uma chave temporária por processo.
# Para manter sessões entre reinicializações, preencha com `openssl rand -hex 32`.
JWT_SECRET=
