# Opcional: o Docker Compose e o backend local funcionam sem .env na raiz.
# Este modelo serve somente ao bootstrap fictício e à persistência opcional de sessões.
# Nunca use credenciais institucionais. O arquivo .env permanece ignorado pelo Git.
ARBORIZA_DEV_ADMIN_BOOTSTRAP_ENABLED=false
ARBORIZA_DEV_ADMIN_EMAIL=admin.dev@example.invalid
ARBORIZA_DEV_ADMIN_PASSWORD=

# Opcional: sem valor, o backend local gera uma chave temporária por processo.
# Para manter sessões entre reinicializações, preencha com `openssl rand -hex 32`.
JWT_SECRET=
